{
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "Yarp": "Information"
      }
    }
  },
  "Cors": {
    "AllowedOrigins": ["http://localhost:5173"]
  },
  "ReverseProxy": {
    "Routes": {
      "auth-route": {
        "ClusterId": "identity-cluster",
        "Match": { "Path": "/api/auth/{**catch-all}" }
      },
      "products-route": {
        "ClusterId": "catalog-cluster",
        "Match": { "Path": "/api/products/{**catch-all}" }
      },
      "orders-route": {
        "ClusterId": "order-cluster",
        "Match": { "Path": "/api/orders/{**catch-all}" }
      },
      "payments-route": {
        "ClusterId": "payment-cluster",
        "Match": { "Path": "/api/payments/{**catch-all}" }
      }
    },
    "Clusters": {
      "identity-cluster": {
        "Destinations": {
          "destination1": { "Address": "http://localhost:5101" }
        }
      },
      "catalog-cluster": {
        "Destinations": {
          "destination1": { "Address": "http://localhost:5102" }
        }
      },
      "order-cluster": {
        "Destinations": {
          "destination1": { "Address": "http://localhost:5103" }
        }
      },
      "payment-cluster": {
        "Destinations": {
          "destination1": { "Address": "http://localhost:5104" }
        }
      }
    }
  },
  "AllowedHosts": "*"
}
